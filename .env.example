# Database (PostgreSQL 16 on local EC2 or RDS)
DATABASE_URL="postgresql://seedfund_user:your-secure-db-password@127.0.0.1:5432/seedfund_db"

# Public site address (used for absolute URLs behind reverse proxy)
PUBLIC_SITE_URL="https://seedfundip.duckdns.org"

# Authentication & Session Security
JWT_SECRET="generate-a-random-secret-key-at-least-32-chars-long"
SESSION_COOKIE_NAME="ideapad_session"
COOKIE_SECURE="true"

# Seeded Administrator (Required for initial setup)
ADMIN_EMAIL="admin@itmuniversity.ac.in"
ADMIN_PASSWORD="YourStrongAdminPasswordHere!"

# Startup Evaluation Committee (SEC) Panel Members (P3)
SEC_MEMBER_1_EMAIL="sec1@ideapad.co.in"
SEC_MEMBER_1_PASSWORD="StrongSecPassword1!"
SEC_MEMBER_2_EMAIL="sec2@ideapad.co.in"
SEC_MEMBER_2_PASSWORD="StrongSecPassword2!"
SEC_MEMBER_3_EMAIL="sec3@ideapad.co.in"
SEC_MEMBER_3_PASSWORD="StrongSecPassword3!"

# Upload Storage (Local disk outside app root or future S3)
STORAGE_PROVIDER="local"
UPLOAD_DIR="/var/lib/seedfund/uploads"
MAX_FILE_SIZE_MB="10"

# SMTP Notifications (Optional)
SMTP_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="noreply@ideapad.co.in"
