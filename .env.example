# Database (SQLite for local dev, Turso libSQL in production on Vercel)
DATABASE_URL="file:./dev.db"
# TURSO_DATABASE_URL="libsql://your-db-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# Auth
JWT_SECRET="your-secret-key-min-32-chars-change-in-production"
SESSION_COOKIE_NAME="ideapad_session"

# Seeded accounts (change passwords after first login)
ADMIN_EMAIL="aschandel.soet@itmuniversity.ac.in"
ADMIN_PASSWORD="Admin@IdeaPad2024"
SEC_MEMBER_1_EMAIL="sec1@ideapad.co.in"
SEC_MEMBER_1_PASSWORD="Sec1@IdeaPad2024"
SEC_MEMBER_2_EMAIL="sec2@ideapad.co.in"
SEC_MEMBER_2_PASSWORD="Sec2@IdeaPad2024"
SEC_MEMBER_3_EMAIL="sec3@ideapad.co.in"
SEC_MEMBER_3_PASSWORD="Sec3@IdeaPad2024"

# SMTP (optional - set SMTP_ENABLED=true to activate email notifications)
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
