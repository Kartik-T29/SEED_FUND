# Server Runtime
PORT="3000"
NODE_ENV="production"
FRONTEND_URL="https://your-domain.edu"
DEMO_MODE="false"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ideapad_seed_fund"

# Auth
JWT_SECRET="change_me_to_a_random_32_character_secret"
SESSION_COOKIE_NAME="ideapad_session"

# Initial Seeded Admin (password forced to change on first login)
ADMIN_EMAIL="admin@ideapad.co.in"
ADMIN_PASSWORD="change_me_admin_secure_password"

# Optional SEC Invite Code (if set, SEC self-registration requires this code)
SEC_INVITE_CODE="OPTIONAL_SEC_REGISTRATION_CODE"

# SMTP (optional - set SMTP_ENABLED=true to activate email notifications)
SMTP_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_FROM="noreply@ideapad.co.in"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="5"
