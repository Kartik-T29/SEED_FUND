# Server Runtime
PORT="3000"
NODE_ENV="production"
FRONTEND_URL="https://your-service-name.onrender.com"
DEMO_MODE="true"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ideapad_seed_fund"

# Auth
JWT_SECRET="change_me_to_a_random_32_character_secret"
SESSION_COOKIE_NAME="ideapad_session"

# Initial seeded accounts (passwords forced to change on first login)
ADMIN_EMAIL="admin@ideapad.co.in"
ADMIN_PASSWORD="change_me_admin_secure_password"
SEC_MEMBER_1_EMAIL="sec1@ideapad.co.in"
SEC_MEMBER_1_PASSWORD="change_me_sec1_secure_password"
SEC_MEMBER_2_EMAIL="sec2@ideapad.co.in"
SEC_MEMBER_2_PASSWORD="change_me_sec2_secure_password"
SEC_MEMBER_3_EMAIL="sec3@ideapad.co.in"
SEC_MEMBER_3_PASSWORD="change_me_sec3_secure_password"

# SMTP (optional - set SMTP_ENABLED=true to activate email notifications)
SMTP_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_FROM="noreply@ideapad.co.in"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="5"
